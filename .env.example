# Supabase (см. Project Settings -> API в Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ВНИМАНИЕ: service role key — только на сервере, никогда не отдавайте на клиент
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kaspi / эквайринг (заполнить когда подключите платёжный сервис)
PAYMENT_WEBHOOK_SECRET=change-me
